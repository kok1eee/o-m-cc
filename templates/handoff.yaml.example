# Handoff - セッション状態の構造化引き継ぎ
#
# ultrawork 完了時に spec/plan/handoff.yaml として保存される
# 次回セッション開始時にこのファイルを読み込んで状態を復元
#
# ⚠️ 重要: このファイルは毎回「上書き」される（累積しない）
# - discoveries → 重要なものは spec/standards/learned/ に転記
# - completed_tasks → 完了したらリセット（spec/plan/tasks.md で追跡）
# - 7日以上古い handoff は無視される

# 最終更新
updated_at: "2026-01-20T14:30:00+09:00"

# 現在の状態
status: "in_progress"  # in_progress | blocked | completed

# 現在取り組んでいるタスク
current_task:
  phase: "Phase 2: 機能実装"
  task: "2-1"
  name: "UserService の実装"
  progress: "70%"

# ブロッカー（なければ null）
blocked_by: null
# blocked_by:
#   reason: "外部API仕様が未確定"
#   waiting_for: "API チームからの回答"
#   since: "2026-01-20"

# セッション中の発見事項
discoveries:
  - type: "pattern"
    content: "このプロジェクトでは Service クラスは必ず interface を先に定義"
    file: "src/services/AuthService.ts"
  - type: "decision"
    content: "認証は JWT ではなく session-based を採用"
    reason: "既存インフラとの互換性"
  - type: "issue"
    content: "UserRepository のテストが不安定"
    severity: "low"

# 完了したタスク（このセッション）
completed_tasks:
  - "1-1"
  - "1-2"

# 完了したフェーズ
completed_phases:
  - "Phase 1: 基盤構築"

# 次のステップ
next_steps:
  - "UserService のテスト追加"
  - "エラーハンドリングの統一"
  - "API ドキュメント更新"

# コンテキスト情報（次回セッションで役立つ）
context:
  key_files:
    - "src/services/UserService.ts"
    - "src/repositories/UserRepository.ts"
  related_docs:
    - "spec/plan/design.md#user-service"
  notes: |
    UserService は AuthService に依存している。
    先に AuthService の interface を確認すること。

# 変更ファイル一覧（自動生成: jj diff / git diff から）
modified_files:
  - "src/services/UserService.ts"
  - "src/repositories/UserRepository.ts"
  - "tests/services/UserService.test.ts"

# 直近のコミット（自動生成: jj log / git log から）
recent_commits:
  - "feat: add UserService.getById"
  - "test: add UserService unit tests"
  - "refactor: extract UserRepository interface"
