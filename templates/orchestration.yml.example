# Orchestration Configuration
# ultrawork がこのファイルを読み込み、タスクグループごとに実行
#
# 生成: /o-m-cc:tasks で tasks.md と同時に生成
# 使用: /o-m-cc:ultrawork で自動読み込み

version: 1

# タスクグループ定義
# - name: Phase 名（tasks.md の ## Phase N: に対応）
# - agent: 実行するエージェント
# - standards: 読み込む Standards（spec/standards/ 配下）
# - tasks: タスクID（tasks.md の "- [ ] N-M:" に対応）
task_groups:
  - name: "Phase 1: Backend API Implementation"
    agent: "general-purpose"
    standards:
      - "global/*"
      - "backend/*"
    tasks:
      - "1-1"
      - "1-2"
      - "1-3"

  - name: "Phase 2: Frontend Components"
    agent: "frontend"
    standards:
      - "global/*"
      - "frontend/*"
    tasks:
      - "2-1"
      - "2-2"

  - name: "Phase 3: Integration & Testing"
    agent: "code-reviewer"
    standards:
      - "testing/*"
    tasks:
      - "3-1"
      - "3-2"

# 並列実行可能なグループ
# 同じ配列内のグループは並列実行される
parallel_groups:
  - ["Phase 1: Backend API Implementation", "Phase 2: Frontend Components"]

# 依存関係
# キーのグループは、値のグループが完了してから実行
dependencies:
  "Phase 3: Integration & Testing":
    - "Phase 1: Backend API Implementation"
    - "Phase 2: Frontend Components"

# エージェントマッピング（オプション）
# カスタムエージェントを使う場合に定義
agent_mapping:
  backend-specialist: "general-purpose"  # 存在しない場合のフォールバック
  test-engineer: "code-reviewer"
