#!/usr/bin/env python3
"""atom-suggest — analytics 駆動の提案エンジン.

atoms.csv / pipeline.csv / outputs.csv / skill-usage.csv / skill-duration.csv /
context.md を統合分析し、backlog 俯瞰と skill ヘルスを 1 レポートで提示する。

セクション:
    [Backlog issues]
        - stale-atoms       : 30 日以上 atom 状態のまま放置
        - promote-ready     : next が具体的な atom（=要件化準備完了）
        - stuck-pipeline    : 14 日以上 implementing / planning のまま
        - orphan-next       : context.md の Next 欄にあるが atoms に無い項目
    [Skill health]
        - top-skills        : 累計使用回数ランキング（top 10）
        - duration-stats    : 実行時間統計（count / avg_ms / max_ms / sum_ms）
        - unused-skills     : 累計使用 ≤ 1 回（proactive=0 → description 改善 / total=0 → 削除候補）
        - gotcha-ranking    : AUTO-GOTCHAS 累計（直近 30 日 / 累計、累計多 = atom 化候補）
    [Activity pulse]
        - recent-atoms      : 直近 7 日に追加された atom
        - recent-skills     : 直近 7 日のトップ skill
        - session-stats     : セッション別 skill 起動数（top 5、v2.1.132+ で session_id 列が必要）
        - effort-breakdown  : effort 別 skill 起動数（xhigh / high / medium / low、v2.1.133+ で effort 列が必要）

Usage:
    atom-suggest                      全セクション
    atom-suggest --json               JSON 出力
"""

from __future__ import annotations

import csv
import datetime as dt
import json
import os
import re
import sys
from collections import Counter
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.repo_root import detect_root  # noqa: E402

STALE_DAYS = 30
STUCK_DAYS = 14
RECENT_DAYS = 7
RECENT_GOTCHA_DAYS = 30  # 直近 N 日の AUTO-GOTCHAS 追加を監視
UNUSED_THRESHOLD = 1  # 累計使用 1 回以下は unused 候補
TOP_N = 10            # ランキング表示件数


ROOT = detect_root()
ATOMS = ROOT / ".claude" / "atoms.csv"
PIPELINE = ROOT / ".claude" / "pipeline.csv"
OUTPUTS = ROOT / ".claude" / "outputs.csv"
CONTEXT = ROOT / ".claude" / "context.md"
PLUGIN_DATA = os.environ.get("CLAUDE_PLUGIN_DATA", "")
USAGE_CSV = Path(PLUGIN_DATA) / "skill-usage.csv" if PLUGIN_DATA else None
DURATION_CSV = Path(PLUGIN_DATA) / "skill-duration.csv" if PLUGIN_DATA else None


def read_csv(path: Path) -> list[dict[str, str]]:
    if not path.exists():
        return []
    with path.open(newline="", encoding="utf-8") as f:
        return list(csv.DictReader(f))


def days_ago(iso_date: str) -> int:
    if not iso_date:
        return 0
    try:
        d = dt.datetime.fromisoformat(iso_date.replace("Z", "+00:00"))
        if d.tzinfo is None:
            d = d.replace(tzinfo=dt.UTC)
        return (dt.datetime.now(dt.UTC) - d).days
    except ValueError:
        return 0


def find_stale_atoms(atoms: list[dict[str, str]]) -> list[dict]:
    out = []
    for a in atoms:
        if a.get("status") != "atom":
            continue
        d = days_ago(a["created_at"])
        if d >= STALE_DAYS:
            out.append({"id": a["id"], "days": d, "content": a["content"], "next": a.get("next", "")})
    return out


def find_promote_ready(atoms: list[dict[str, str]]) -> list[dict]:
    """next に具体的な action verb が書かれている atom（promotion 候補）"""
    action_keywords = ["実装", "作る", "追加", "やる", "ためす", "試す", "書く", "create", "implement", "add"]
    out = []
    for a in atoms:
        if a.get("status") != "atom":
            continue
        next_val = (a.get("next") or "").lower()
        if any(k in next_val for k in action_keywords):
            out.append({"id": a["id"], "next": a["next"], "content": a["content"]})
    return out


def find_stuck_pipeline(pipeline: list[dict[str, str]]) -> list[dict]:
    out = []
    for p in pipeline:
        if p.get("status") not in ("planning", "implementing", "reviewing"):
            continue
        d = days_ago(p["promoted_at"])
        if d >= STUCK_DAYS:
            out.append({"id": p["id"], "atom_id": p["atom_id"], "days": d,
                        "status": p["status"], "plan_path": p.get("plan_path", "")})
    return out


def split_usage_counts(usage: list[dict[str, str]]) -> tuple[Counter, Counter, Counter]:
    """usage rows から (total, proactive, slash) の Counter を作る。

    旧スキーマ（trigger 列なし）のデータは total にだけ計上され proactive/slash は 0。
    """
    total = Counter(u.get("skill", "") for u in usage)
    proactive = Counter(u.get("skill", "") for u in usage if u.get("trigger") == "claude-proactive")
    slash = Counter(u.get("skill", "") for u in usage if u.get("trigger") == "user-slash")
    return total, proactive, slash


def find_top_skills(counts: Counter) -> list[tuple[str, int]]:
    return counts.most_common(TOP_N)


def find_duration_stats() -> list[dict]:
    """skill 別の実行時間統計（count / avg_ms / max_ms / sum_ms）"""
    if not DURATION_CSV or not DURATION_CSV.exists():
        return []
    stats: dict[str, dict] = {}
    for r in read_csv(DURATION_CSV):
        d = int(r.get("duration_ms", 0) or 0)
        if d <= 0:
            continue
        s = r.get("skill", "")
        if s not in stats:
            stats[s] = {"count": 0, "sum": 0, "max": 0}
        stats[s]["count"] += 1
        stats[s]["sum"] += d
        stats[s]["max"] = max(stats[s]["max"], d)
    out = [
        {"skill": s, "count": v["count"], "avg_ms": v["sum"] // v["count"],
         "max_ms": v["max"], "sum_ms": v["sum"]}
        for s, v in stats.items()
    ]
    return sorted(out, key=lambda x: -x["sum_ms"])[:TOP_N]


def _skill_override_recommendation(total: int, proactive: int, slash: int) -> str:
    """unused 判定スキルに対する skillOverrides 推奨アクションを返す。

    Claude Code v2.1.129+ の skillOverrides 設定（off / user-invocable-only / name-only）
    を踏まえ、計測結果から actionable な対応を 1 ワードで返す:

    - total=0:                  off            (誰も使ってない、完全に隠す)
    - proactive=0 で slash≥1:   user-invocable-only (自動発動が効かない、/slash のみ残す)
    - proactive≥1 で slash=0:   keep           (proactive で動いてる、現状維持)
    - proactive≥1 で slash≥1:   keep           (両方使われてる、現状維持)
    """
    if total == 0:
        return "off"
    if proactive == 0 and slash >= 1:
        return "user-invocable-only"
    return "keep"


def find_unused_skills(total: Counter, proactive: Counter, slash: Counter) -> list[dict]:
    """登録されている skill のうち、累計使用 ≤ 1 回のもの。

    proactive=0 で slash≥1: ユーザーは使うが Claude が自動発動しない（description 改善候補）
    total=0:                完全に未使用（削除候補）
    proactive≥1:            自動発動する（OK）
    """
    skills_dir = ROOT / "skills"
    if not skills_dir.exists():
        return []
    out = []
    for skill_md in skills_dir.glob("*/SKILL.md"):
        name = skill_md.parent.name
        # plugin prefix 付き / なし両方を加算（hook の出力形式が混在するため）
        c = total.get(f"o-m-cc:{name}", 0) + total.get(name, 0)
        p = proactive.get(f"o-m-cc:{name}", 0) + proactive.get(name, 0)
        s = slash.get(f"o-m-cc:{name}", 0) + slash.get(name, 0)
        if c <= UNUSED_THRESHOLD:
            out.append({
                "skill": name, "count": c, "proactive": p, "slash": s,
                "recommend": _skill_override_recommendation(c, p, s),
            })
    return sorted(out, key=lambda x: x["count"])


def find_gotcha_ranking() -> list[dict]:
    """各 SKILL.md の AUTO-GOTCHAS を集計（直近 N 日 / 累計）。

    累計が多い skill は改善余地あり = atom 化候補。
    `- **[YYYY-MM-DD]` 形式の日付プレフィックスを recent 判定に使う。
    """
    skills_dir = ROOT / "skills"
    if not skills_dir.exists():
        return []
    cutoff = dt.datetime.now(dt.UTC) - dt.timedelta(days=RECENT_GOTCHA_DAYS)
    results = []
    for skill_md in skills_dir.glob("*/SKILL.md"):
        name = skill_md.parent.name
        try:
            text = skill_md.read_text(encoding="utf-8")
        except OSError:
            continue
        if "<!-- AUTO-GOTCHAS -->" not in text:
            continue
        # SKILL.md 自体がマーカーをドキュメント例として言及することがある（evolve など）。
        # 最後のマーカー以降を真のセクションとして扱い、かつ日付プレフィックス
        # [YYYY-MM-DD] を持つ bullet のみカウントする（フォーマット例 `[日付]` を除外）。
        last_marker = text.rfind("<!-- AUTO-GOTCHAS -->")
        auto_section = text[last_marker:]
        date_re = re.compile(r"\[(\d{4}-\d{2}-\d{2})\]")
        dated_lines = []
        for ln in auto_section.splitlines():
            if not ln.startswith("- "):
                continue
            m = date_re.search(ln)
            if m:
                dated_lines.append((ln, m.group(1)))
        total = len(dated_lines)
        if total == 0:
            continue
        recent = 0
        for _ln, date_str in dated_lines:
            try:
                d = dt.datetime.fromisoformat(date_str).replace(tzinfo=dt.UTC)
                if d >= cutoff:
                    recent += 1
            except ValueError:
                pass
        results.append({"skill": name, "recent": recent, "total": total})
    return sorted(results, key=lambda x: (-x["recent"], -x["total"]))[:TOP_N]


def find_orphan_next(atoms: list[dict[str, str]], pipeline: list[dict[str, str]]) -> list[str]:
    """context.md の Next 欄にある項目のうち、atoms にも pipeline にも無いもの"""
    if not CONTEXT.exists():
        return []
    text = CONTEXT.read_text(encoding="utf-8")
    next_section = re.search(r"\*\*Next:\*\*(.*?)(?=\*\*\w+:\*\*|\Z)", text, re.DOTALL)
    if not next_section:
        return []
    items = []
    for line in next_section.group(1).splitlines():
        line = line.strip()
        if line.startswith("- ") and len(line) > 3:
            items.append(line[2:])
    if not items:
        return []
    known_keywords = set()
    for r in atoms + pipeline:
        for word in re.findall(r"[\w\-]{3,}", r.get("content", "")):
            known_keywords.add(word.lower())
    orphans = []
    for item in items:
        item_words = re.findall(r"[\w\-]{3,}", item.lower())
        if not any(w in known_keywords for w in item_words):
            orphans.append(item)
    return orphans


def find_recent_activity(atoms: list[dict[str, str]], usage: list[dict[str, str]]) -> dict:
    recent_atoms = []
    for a in atoms:
        d = days_ago(a["created_at"])
        if d <= RECENT_DAYS:
            recent_atoms.append({"id": a["id"], "days": d, "content": a["content"]})
    skill_counts: Counter = Counter(
        u["skill"] for u in usage
        if days_ago(u.get("timestamp", "")) <= RECENT_DAYS
    )
    return {"atoms": recent_atoms, "top_skills": skill_counts.most_common(5)}


def find_session_stats(usage: list[dict[str, str]]) -> list[dict]:
    """セッション別 skill 起動数（session_id 列が無い旧データはスキップ）"""
    by_session: dict[str, Counter] = {}
    for u in usage:
        sid = (u.get("session_id") or "").strip()
        if not sid:
            continue
        by_session.setdefault(sid, Counter())[u.get("skill", "")] += 1
    out = []
    for sid, counts in by_session.items():
        out.append({
            "session_id": sid[:8],  # 短縮表示
            "total": sum(counts.values()),
            "top": counts.most_common(3),
        })
    return sorted(out, key=lambda x: -x["total"])[:5]


def find_effort_breakdown(usage: list[dict[str, str]]) -> list[dict]:
    """effort 別 skill 起動数（effort 列が無い旧データはスキップ）。

    Claude Code v2.1.133+ で hooks に effort.level / $CLAUDE_EFFORT が渡る。
    各 skill が xhigh / high / medium / low のどれで呼ばれているかを集計し、
    例えば「sisyphus は xhigh で重く、quality-gate は medium で軽く」などの
    使い分けパターンを可視化する。
    """
    by_effort: dict[str, Counter] = {}
    for u in usage:
        effort = (u.get("effort") or "").strip()
        if not effort:
            continue
        by_effort.setdefault(effort, Counter())[u.get("skill", "")] += 1
    # xhigh > high > medium > low の順で表示（その他は末尾）
    order = {"xhigh": 0, "high": 1, "medium": 2, "low": 3}
    out = []
    for effort, counts in by_effort.items():
        out.append({
            "effort": effort,
            "total": sum(counts.values()),
            "top": counts.most_common(3),
        })
    return sorted(out, key=lambda x: order.get(x["effort"], 99))


def collect_all() -> dict:
    atoms = read_csv(ATOMS)
    pipeline = read_csv(PIPELINE)
    usage = read_csv(USAGE_CSV) if USAGE_CSV and USAGE_CSV.exists() else []
    total, proactive, slash = split_usage_counts(usage)
    return {
        "stale_atoms": find_stale_atoms(atoms),
        "promote_ready": find_promote_ready(atoms),
        "stuck_pipeline": find_stuck_pipeline(pipeline),
        "orphan_next": find_orphan_next(atoms, pipeline),
        "top_skills": find_top_skills(total),
        "duration_stats": find_duration_stats(),
        "unused_skills": find_unused_skills(total, proactive, slash),
        "gotcha_ranking": find_gotcha_ranking(),
        "recent_activity": find_recent_activity(atoms, usage),
        "session_stats": find_session_stats(usage),
        "effort_breakdown": find_effort_breakdown(usage),
    }


def print_section(title: str, items: list, formatter) -> None:
    print(f"\n## {title} ({len(items)})")
    if not items:
        print("  (なし)")
        return
    for item in items:
        print(f"  - {formatter(item)}")


def main() -> None:
    if "--json" in sys.argv:
        print(json.dumps(collect_all(), ensure_ascii=False, indent=2, default=str))
        return

    if len(sys.argv) >= 2 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return

    data = collect_all()

    print("# atom-suggest report")
    print(f"# generated: {dt.datetime.now(dt.UTC).strftime('%Y-%m-%d %H:%M UTC')}")
    print(f"# thresholds: stale={STALE_DAYS}d, stuck={STUCK_DAYS}d, recent={RECENT_DAYS}d, gotcha={RECENT_GOTCHA_DAYS}d, unused≤{UNUSED_THRESHOLD}")

    print("\n# === Backlog issues ===")
    print_section(f"Stale atoms (>{STALE_DAYS}日放置)", data["stale_atoms"],
                  lambda x: f"{x['id']} ({x['days']}日): {x['content'][:60]}")
    print_section("Promote-ready (next が具体的)", data["promote_ready"],
                  lambda x: f"{x['id']}: next='{x['next'][:50]}' / {x['content'][:50]}")
    print_section(f"Stuck pipeline (>{STUCK_DAYS}日進捗なし)", data["stuck_pipeline"],
                  lambda x: f"{x['id']} ({x['days']}日, {x['status']}): atom={x['atom_id']} plan={x['plan_path']}")
    print_section("Orphan next (context.md にあるが atoms に無い)", data["orphan_next"],
                  lambda x: x[:80])

    print("\n# === Skill health ===")
    if data["top_skills"]:
        print(f"\n## Top skills (累計使用回数 top {TOP_N})")
        for s, c in data["top_skills"]:
            print(f"  - {s}: {c}回")
    else:
        print("\n## Top skills (なし)")

    if data["duration_stats"]:
        print(f"\n## Duration stats (sum_ms 降順 top {TOP_N})")
        print(f"  {'skill':<30} {'count':>6} {'avg_ms':>8} {'max_ms':>8} {'sum_ms':>8}")
        for s in data["duration_stats"]:
            print(f"  {s['skill']:<30} {s['count']:>6} {s['avg_ms']:>8} {s['max_ms']:>8} {s['sum_ms']:>8}")
    else:
        print("\n## Duration stats (なし、Claude Code 2.1.119+ で記録開始)")

    print_section(f"Unused skills (累計 ≤{UNUSED_THRESHOLD}回)", data["unused_skills"],
                  lambda x: f"{x['skill']} ({x['count']}回 / proactive={x['proactive']}, slash={x['slash']}) → {x['recommend']}")

    overrides = {
        x["skill"]: x["recommend"]
        for x in data["unused_skills"]
        if x["recommend"] != "keep"
    }
    if overrides:
        print("\n## skillOverrides 設定例（~/.claude/settings.json に追記）")
        print("  {")
        print('    "skillOverrides": {')
        items = sorted(overrides.items())
        for i, (skill, action) in enumerate(items):
            comma = "," if i < len(items) - 1 else ""
            print(f'      "o-m-cc:{skill}": "{action}"{comma}')
        print("    }")
        print("  }")
        print("  off                : Claude proactive / slash 両方から隠す（total=0 の場合）")
        print("  user-invocable-only: /slash のみ残し Claude proactive 候補から外す（slash≥1 で proactive=0）")

    print_section(f"Gotcha ranking (直近 {RECENT_GOTCHA_DAYS}日 / 累計、累計多 = atom 化候補)",
                  data["gotcha_ranking"],
                  lambda x: f"{x['skill']}: 直近 {x['recent']} 件 / 累計 {x['total']} 件")

    print(f"\n# === Activity pulse (直近 {RECENT_DAYS}日) ===")
    print(f"  recent atoms: {len(data['recent_activity']['atoms'])}")
    for a in data["recent_activity"]["atoms"]:
        print(f"    - {a['id']} ({a['days']}日): {a['content'][:60]}")
    if data["recent_activity"]["top_skills"]:
        print("  recent top skills:")
        for skill, count in data["recent_activity"]["top_skills"]:
            print(f"    - {skill}: {count}回")

    if data["session_stats"]:
        print("\n## Session stats (top 5、Claude Code v2.1.132+ で session_id 記録開始)")
        for s in data["session_stats"]:
            top_str = ", ".join(f"{name}={n}" for name, n in s["top"])
            print(f"  - session {s['session_id']}…: total {s['total']}回 ({top_str})")

    if data["effort_breakdown"]:
        print("\n## Effort breakdown (Claude Code v2.1.133+ で effort 記録開始)")
        for e in data["effort_breakdown"]:
            top_str = ", ".join(f"{name}={n}" for name, n in e["top"])
            print(f"  - {e['effort']:<7}: total {e['total']}回 ({top_str})")


if __name__ == "__main__":
    main()
