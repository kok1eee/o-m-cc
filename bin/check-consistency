#!/bin/bash
# check-consistency — agents/skills 数 + version 表記の一貫性を Layer 1 で検証
#
# 検出対象（authoritative な統計のみ）:
#   1. CLAUDE.md の任意の数値（短いので全部対象）
#   2. README.md の「合計 X」「X 定義」「X の専門」パターン
#   3. plugin.json / marketplace.json の description
#   4. plugin.json.version vs marketplace.json.version vs README.md トップ "vX.Y.Z"
#
# 除外:
#   - workflow 説明（X 並列、X エージェント並列）
#   - CHANGELOG 履歴セクション
#
# Exit:
#   0 = 全て一致
#   1 = 1 件以上の乖離あり（stdout に詳細出力）

set -euo pipefail

ROOT=$(jj root 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$ROOT"

errors=()

# === actual counts ===
# capabilities.md は meta なので除外。README は「16 specialized + capabilities」と書く慣習
AGENTS_ACTUAL=$(find agents -maxdepth 1 -name '*.md' -not -name 'capabilities.md' 2>/dev/null | wc -l | tr -d ' ')
SKILLS_ACTUAL=$(find skills -maxdepth 2 -name 'SKILL.md' 2>/dev/null | wc -l | tr -d ' ')
PLUGIN_VERSION=$(jq -r '.version' .claude-plugin/plugin.json 2>/dev/null || echo "")
MARKETPLACE_VERSION=$(jq -r '.plugins[0].version // .version // empty' .claude-plugin/marketplace.json 2>/dev/null || echo "")

echo "## 実数 / 正準値"
echo "  agents (capabilities.md 除く): $AGENTS_ACTUAL"
echo "  skills/*/SKILL.md            : $SKILLS_ACTUAL"
echo "  plugin.json.version          : $PLUGIN_VERSION"
echo "  marketplace.json.version     : $MARKETPLACE_VERSION"

# === version 一致 ===
if [[ -n "$PLUGIN_VERSION" && -n "$MARKETPLACE_VERSION" && "$PLUGIN_VERSION" != "$MARKETPLACE_VERSION" ]]; then
  errors+=("version 不一致: plugin.json=$PLUGIN_VERSION marketplace.json=$MARKETPLACE_VERSION")
fi

README_VERSION=$(grep -m1 -oE 'v[0-9]+\.[0-9]+\.[0-9]+' README.md 2>/dev/null | head -1 | sed 's/^v//')
if [[ -n "$README_VERSION" && -n "$PLUGIN_VERSION" && "$README_VERSION" != "$PLUGIN_VERSION" ]]; then
  errors+=("README.md トップ version (v$README_VERSION) != plugin.json version (v$PLUGIN_VERSION)")
fi

# === 数値表記チェック ===
# 検証パターン: 1 行に "<n> (agents|skills|エージェント|スキル)" を含み、
# かつ authoritative マーカー（合計 / 定義 / 専門）を持つ。
# 除外: 並列 / changelog 範囲

check_authoritative_counts() {
  local file="$1"
  local actual_agents="$2"
  local actual_skills="$3"
  local mode="$4"  # "all" = 全行、"authoritative" = 統計マーカー必須
  [[ -f "$file" ]] || return 0

  local in_changelog=0
  local lineno=0
  while IFS= read -r content; do
    lineno=$((lineno + 1))

    # CHANGELOG / 履歴セクション検出（## 履歴 / ## 変更履歴 / ## CHANGELOG / ## Changelog / ## 過去）
    if [[ "$content" =~ ^##[[:space:]]+(履歴|変更履歴|CHANGELOG|Changelog|過去|更新履歴) ]]; then
      in_changelog=1
      continue
    fi
    # 別の同レベルセクションが始まったら changelog 終了
    if [[ $in_changelog -eq 1 && "$content" =~ ^##[[:space:]] ]]; then
      in_changelog=0
    fi
    [[ $in_changelog -eq 1 ]] && continue

    # 数値+kind を含まない行はスキップ
    [[ "$content" =~ [0-9]+[[:space:]](agents|skills|エージェント|スキル) ]] || continue

    # 並列ワークフローは除外
    echo "$content" | grep -qE '並列|並走|セットでのみ|草案' && continue

    # mode=authoritative: 合計 / 定義 / 専門 マーカーまたは tree comment (├/│) を要求
    if [[ "$mode" == "authoritative" ]]; then
      echo "$content" | grep -qE '合計|定義|専門|^├|^│|^[[:space:]]*├|^[[:space:]]*│' || continue
    fi

    while read -r match; do
      local n kind
      n=$(echo "$match" | grep -oE '^[0-9]+')
      kind=$(echo "$match" | grep -oE '(agents|skills|エージェント|スキル)')
      [[ -z "$n" || -z "$kind" ]] && continue
      case "$kind" in
        agents|エージェント)
          [[ "$n" != "$actual_agents" ]] && errors+=("$file:$lineno  '$n $kind' != 実数 $actual_agents agents")
          ;;
        skills|スキル)
          [[ "$n" != "$actual_skills" ]] && errors+=("$file:$lineno  '$n $kind' != 実数 $actual_skills skills")
          ;;
      esac
    done < <(echo "$content" | grep -oE '[0-9]+ (agents|skills|エージェント|スキル)')
  done < "$file"
  return 0
}

# CLAUDE.md は短いので全行チェック
check_authoritative_counts "CLAUDE.md" "$AGENTS_ACTUAL" "$SKILLS_ACTUAL" "all"
# README.md は authoritative マーカー必須
check_authoritative_counts "README.md" "$AGENTS_ACTUAL" "$SKILLS_ACTUAL" "authoritative"

# === plugin.json / marketplace.json description ===
check_json_desc() {
  local file="$1"
  local jq_path="$2"
  local desc; desc=$(jq -r "$jq_path" "$file" 2>/dev/null || echo "")
  [[ -z "$desc" ]] && return 0
  while read -r match; do
    n=$(echo "$match" | grep -oE '^[0-9]+')
    kind=$(echo "$match" | grep -oE '(agents|skills|エージェント|スキル)')
    [[ -z "$n" || -z "$kind" ]] && continue
    case "$kind" in
      agents|エージェント)
        [[ "$n" != "$AGENTS_ACTUAL" ]] && errors+=("$(basename "$file") description: '$n $kind' != 実数 $AGENTS_ACTUAL agents")
        ;;
      skills|スキル)
        [[ "$n" != "$SKILLS_ACTUAL" ]] && errors+=("$(basename "$file") description: '$n $kind' != 実数 $SKILLS_ACTUAL skills")
        ;;
    esac
  done < <(echo "$desc" | grep -oE '[0-9]+ (agents|skills|エージェント|スキル)')
  return 0
}
check_json_desc ".claude-plugin/plugin.json" '.description // ""'
check_json_desc ".claude-plugin/marketplace.json" '.plugins[0].description // ""'

# === 結果 ===
echo ""
if [[ ${#errors[@]} -eq 0 ]]; then
  echo "✅ all consistent"
  exit 0
fi

echo "❌ ${#errors[@]} 件の乖離:"
for e in "${errors[@]}"; do
  echo "  - $e"
done
exit 1
