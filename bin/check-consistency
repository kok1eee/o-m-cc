#!/bin/bash
# check-consistency — agents/skills 数 + version 表記の一貫性を Layer 1 で検証
#
# 検出対象（authoritative な統計のみ）:
#   1. CLAUDE.md の任意の数値（短いので全部対象）
#   2. README.md の「合計 X」「X 定義」「X の専門」パターン
#   3. plugin.json / marketplace.json の description
#   4. plugin.json.version vs marketplace.json.version vs README.md トップ "vX.Y.Z"
#
# 除外:
#   - workflow 説明（X 並列、X エージェント並列）
#   - CHANGELOG 履歴セクション
#
# Exit:
#   0 = 全て一致
#   1 = 1 件以上の乖離あり（stdout に詳細出力）

set -euo pipefail

# 共通ライブラリから detect_repo_root を流用 (jj → git → cwd)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../hooks/lib/common.sh
source "$SCRIPT_DIR/../hooks/lib/common.sh"

ROOT=$(detect_repo_root)
cd "$ROOT"

errors=()

# === actual counts ===
# capabilities.md は meta なので除外。README は「16 specialized + capabilities」と書く慣習
AGENTS_ACTUAL=$(find agents -maxdepth 1 -name '*.md' -not -name 'capabilities.md' 2>/dev/null | wc -l | tr -d ' ')
SKILLS_ACTUAL=$(find skills -maxdepth 2 -name 'SKILL.md' 2>/dev/null | wc -l | tr -d ' ')
PLUGIN_VERSION=$(jq -r '.version' .claude-plugin/plugin.json 2>/dev/null || echo "")
MARKETPLACE_VERSION=$(jq -r '.plugins[0].version // .version // empty' .claude-plugin/marketplace.json 2>/dev/null || echo "")

echo "## 実数 / 正準値"
echo "  agents (capabilities.md 除く): $AGENTS_ACTUAL"
echo "  skills/*/SKILL.md            : $SKILLS_ACTUAL"
echo "  plugin.json.version          : $PLUGIN_VERSION"
echo "  marketplace.json.version     : $MARKETPLACE_VERSION"

# === version 一致 ===
if [[ -n "$PLUGIN_VERSION" && -n "$MARKETPLACE_VERSION" && "$PLUGIN_VERSION" != "$MARKETPLACE_VERSION" ]]; then
  errors+=("version 不一致: plugin.json=$PLUGIN_VERSION marketplace.json=$MARKETPLACE_VERSION")
fi

README_VERSION=$(grep -m1 -oE 'v[0-9]+\.[0-9]+\.[0-9]+' README.md 2>/dev/null | head -1 | sed 's/^v//')
if [[ -n "$README_VERSION" && -n "$PLUGIN_VERSION" && "$README_VERSION" != "$PLUGIN_VERSION" ]]; then
  errors+=("README.md トップ version (v$README_VERSION) != plugin.json version (v$PLUGIN_VERSION)")
fi

# === 数値表記チェック ===
# 検証パターン: 1 行に "<n> (agents|skills|エージェント|スキル)" を含み、
# かつ authoritative マーカー（合計 / 定義 / 専門）を持つ。
# 除外: 並列 / changelog 範囲

check_authoritative_counts() {
  local file="$1"
  local actual_agents="$2"
  local actual_skills="$3"
  local mode="$4"  # "all" = 全行、"authoritative" = 統計マーカー必須
  [[ -f "$file" ]] || return 0

  # awk 1 invocation で全行を処理する。各乖離行を tab 区切りで stdout に出す。
  # 旧実装は while read + 複数 grep fork で千〜数千 fork が発生していた。
  local awk_output
  awk_output=$(awk -v actual_agents="$actual_agents" \
                   -v actual_skills="$actual_skills" \
                   -v mode="$mode" '
    BEGIN { in_changelog = 0 }

    /^##[[:space:]]+(履歴|変更履歴|CHANGELOG|Changelog|過去|更新履歴)/ {
      in_changelog = 1; next
    }
    in_changelog && /^##[[:space:]]/ { in_changelog = 0 }
    in_changelog { next }

    # 数値+kind を含まない行はスキップ
    !/[0-9]+[[:space:]](agents|skills|エージェント|スキル)/ { next }

    # 並列ワークフローは除外
    /並列|並走|セットでのみ|草案/ { next }

    # mode=authoritative: 統計マーカーを要求
    {
      if (mode == "authoritative" && $0 !~ /合計|定義|専門|^[[:space:]]*[├│]/) next
      line = $0
      while (match(line, /[0-9]+[[:space:]](agents|skills|エージェント|スキル)/)) {
        chunk = substr(line, RSTART, RLENGTH)
        sp = index(chunk, " ")
        if (sp == 0) { line = substr(line, RSTART + RLENGTH); continue }
        n = substr(chunk, 1, sp - 1)
        kind = substr(chunk, sp + 1)
        if (kind == "agents" || kind == "エージェント") {
          if (n != actual_agents) printf "%d\t%s\t%s\t%d\n", NR, n, kind, actual_agents
        } else {
          if (n != actual_skills) printf "%d\t%s\t%s\t%d\n", NR, n, kind, actual_skills
        }
        line = substr(line, RSTART + RLENGTH)
      }
    }
  ' "$file")

  if [[ -z "$awk_output" ]]; then
    return 0
  fi

  while IFS=$'\t' read -r lineno n kind expected; do
    case "$kind" in
      agents|エージェント)
        errors+=("$file:$lineno  '$n $kind' != 実数 $expected agents")
        ;;
      skills|スキル)
        errors+=("$file:$lineno  '$n $kind' != 実数 $expected skills")
        ;;
    esac
  done <<< "$awk_output"
  return 0
}

# CLAUDE.md は短いので全行チェック
check_authoritative_counts "CLAUDE.md" "$AGENTS_ACTUAL" "$SKILLS_ACTUAL" "all"
# README.md は authoritative マーカー必須
check_authoritative_counts "README.md" "$AGENTS_ACTUAL" "$SKILLS_ACTUAL" "authoritative"

# === plugin.json / marketplace.json description ===
check_json_desc() {
  local file="$1"
  local jq_path="$2"
  local desc; desc=$(jq -r "$jq_path" "$file" 2>/dev/null || echo "")
  [[ -z "$desc" ]] && return 0
  while read -r match; do
    local n="${match%% *}"
    local kind="${match##* }"
    [[ -z "$n" || -z "$kind" ]] && continue
    case "$kind" in
      agents|エージェント)
        [[ "$n" != "$AGENTS_ACTUAL" ]] && errors+=("$(basename "$file") description: '$n $kind' != 実数 $AGENTS_ACTUAL agents")
        ;;
      skills|スキル)
        [[ "$n" != "$SKILLS_ACTUAL" ]] && errors+=("$(basename "$file") description: '$n $kind' != 実数 $SKILLS_ACTUAL skills")
        ;;
    esac
  done < <(echo "$desc" | grep -oE '[0-9]+ (agents|skills|エージェント|スキル)')
  return 0
}
check_json_desc ".claude-plugin/plugin.json" '.description // ""'
check_json_desc ".claude-plugin/marketplace.json" '.plugins[0].description // ""'

# === skill 名衝突チェック (A080) ===
# skills/*/SKILL.md の name が built-in skill / 既知コマンド名・他 installed plugin 名
# と衝突していないか検知する。衝突すると bare 呼び出し（/code-review 等）が曖昧化する。
# A057 で built-in /code-review と marketplace plugin code-review:code-review の衝突を
# 実体験したことの構造的予防（Sensors 止まり: 検知のみ、warning 表示で exit code には
# 影響させない。built-in リストは手動メンテのハードコードで、誤検知が CI を止めるべき
# でないため）。
check_skill_name_conflicts() {
  # 手動メンテの予約名リスト（built-in skill / slash command で、衝突すると曖昧化する）。
  # Claude Code の version 更新で built-in が増えたら随時追記する。
  local builtins="code-review simplify plan goal review advisor"
  local conflicts=()

  # installed_plugins.json から自身（o-m-cc）を除く plugin 名（@ 前）を取得
  local plugin_names="" ipj="$HOME/.claude/plugins/installed_plugins.json"
  if [[ -f "$ipj" ]]; then
    plugin_names=$(jq -r '.plugins | keys[]' "$ipj" 2>/dev/null \
      | sed 's/@.*//' | grep -vx 'o-m-cc' | sort -u || true)
  fi

  local f name
  for f in skills/*/SKILL.md; do
    [[ -f "$f" ]] || continue
    name=$(awk -F': ' '/^name:/{gsub(/[" ]/,"",$2); print $2; exit}' "$f")
    [[ -z "$name" ]] && continue
    if grep -qw -- "$name" <<< "$builtins"; then
      conflicts+=("skills/$name/ の name='$name' が built-in skill/コマンドと衝突（/$name の bare 呼び出しが曖昧化）")
    fi
    if [[ -n "$plugin_names" ]] && grep -qxF -- "$name" <<< "$plugin_names"; then
      conflicts+=("skills/$name/ の name='$name' が installed plugin 名と衝突（$name:... 呼び出しが曖昧化）")
    fi
  done

  if [[ ${#conflicts[@]} -gt 0 ]]; then
    echo ""
    echo "⚠️  skill 名衝突 (${#conflicts[@]} 件 / warning のみ、exit code 不変):"
    for c in "${conflicts[@]}"; do echo "  - $c"; done
  fi
}
check_skill_name_conflicts

# === 結果 ===
echo ""
if [[ ${#errors[@]} -eq 0 ]]; then
  echo "✅ all consistent"
  exit 0
fi

echo "❌ ${#errors[@]} 件の乖離:"
for e in "${errors[@]}"; do
  echo "  - $e"
done
exit 1
